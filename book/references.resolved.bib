  publisher = {Springer Science and Business Media LLC},
  title = {Expanded Encyclopaedias of {DNA} Elements in the Human and
    Mouse Genomes},
  journal = {Nature},
  volume = {583},
  number = {7818},
  pages = {699-710},
  date = {2020-07-29},
  url = {https://doi.org/gg6dhk},
  doi = {10.1038/s41586-020-2493-4},
  note = {This CSL Item was generated by Manubot v0.6.1 from its
    persistent identifier (standard\_id). standard\_id:
    doi:10.1038/s41586-020-2493-4},
  langid = {en},
  abstract = {\textless jats:title\textgreater
    Abstract\textless/jats:title\textgreater{} \textless
    jats:p\textgreater{} The human and mouse genomes contain
    instructions that specify RNAs and proteins and govern the timing,
    magnitude, and cellular context of their production. To better
    delineate these elements, phase III of the Encyclopedia of DNA
    Elements (ENCODE) Project has expanded analysis of the cell and
    tissue repertoires of RNA transcription, chromatin structure and
    modification, DNA methylation, chromatin looping, and occupancy by
    transcription factors and RNA-binding proteins. Here we summarize
    these efforts, which have produced 5,992 new experimental datasets,
    including systematic determinations across mouse fetal development.
    All data are available through the ENCODE data portal ( \textless
    jats:ext-link xmlns:xlink=“http://www.w3.org/1999/xlink”
    ext-link-type=“uri”
    xlink:href=“https://www.encodeproject.org”\textgreater
    https://www.encodeproject.org\textless/jats:ext-link\textgreater{}
    ), including phase II ENCODE \textless
    jats:sup\textgreater1\textless/jats:sup\textgreater{} and Roadmap
    Epigenomics \textless
    jats:sup\textgreater2\textless/jats:sup\textgreater{} data. We have
    developed a registry of 926,535 human and 339,815 mouse candidate
    \textless jats:italic\textgreater
    cis\textless/jats:italic\textgreater{} -regulatory elements,
    covering 7.9 and 3.4\% of their respective genomes, by integrating
    selected datatypes associated with gene regulation, and constructed
    a web-based server (SCREEN; \textless jats:ext-link
    xmlns:xlink=“http://www.w3.org/1999/xlink” ext-link-type=“uri”
    xlink:href=“http://screen.encodeproject.org”\textgreater
    http://screen.encodeproject.org\textless/jats:ext-link\textgreater{}
    ) to provide flexible, user-defined access to this resource.
    Collectively, the ENCODE data and registry provide an expansive
    resource for the scientific community to build a better
    understanding of the organization and function of the human and
    mouse genomes. \textless/jats:p\textgreater{}}
}
@article{doi:10.1038/s41598-023-41032-5,
  author = {Walters, William H. and Wilder, Esther Isabelle},
  publisher = {Springer Science and Business Media LLC},
  title = {Fabrication and Errors in the Bibliographic Citations
    Generated by {ChatGPT}},
  journal = {Scientific Reports},
  volume = {13},
  number = {1},
  date = {2023-09-07},
  url = {https://doi.org/ksxd},
  doi = {10.1038/s41598-023-41032-5},
  note = {This CSL Item was generated by Manubot v0.6.1 from its
    persistent identifier (standard\_id). standard\_id:
    doi:10.1038/s41598-023-41032-5},
  langid = {en},
  abstract = {\textless jats:title\textgreater
    Abstract\textless/jats:title\textgreater{} \textless
    jats:p\textgreater Although chatbots such as ChatGPT can facilitate
    cost-effective text generation and editing, factually incorrect
    responses (hallucinations) limit their utility. This study evaluates
    one particular type of hallucination: fabricated bibliographic
    citations that do not represent actual scholarly works. We used
    ChatGPT-3.5 and ChatGPT-4 to produce short literature reviews on 42
    multidisciplinary topics, compiling data on the 636 bibliographic
    citations (references) found in the 84 papers. We then searched
    multiple databases and websites to determine the prevalence of
    fabricated citations, to identify errors in the citations to
    non-fabricated papers, and to evaluate adherence to APA citation
    format. Within this set of documents, 55\% of the GPT-3.5 citations
    but just 18\% of the GPT-4 citations are fabricated. Likewise, 43\%
    of the real (non-fabricated) GPT-3.5 citations but just 24\% of the
    real GPT-4 citations include substantive citation errors. Although
    GPT-4 is a major improvement over GPT-3.5, problems
    remain.\textless/jats:p\textgreater{}}
}
@article{doi:10.1073/pnas.0914005107,
  author = {Bourgon, Richard and Gentleman, Robert and Huber, Wolfgang},
  publisher = {National Academy of Sciences},
  title = {Independent Filtering Increases Detection Power for
    High-Throughput Experiments},
  journal = {Proceedings of the National Academy of Sciences},
  volume = {107},
  number = {21},
  pages = {9546-9551},
  date = {2010-05-11},
  url = {https://doi.org/b94qj2},
  doi = {10.1073/pnas.0914005107},
  note = {This CSL Item was generated by Manubot v0.6.1 from its
    persistent identifier (standard\_id). standard\_id:
    doi:10.1073/pnas.0914005107},
  langid = {en},
  abstract = {\textless jats:p\textgreater{} With high-dimensional data,
    variable-by-variable statistical testing is often used to select
    variables whose behavior differs across conditions. Such an approach
    requires adjustment for multiple testing, which can result in low
    statistical power. A two-stage approach that first filters variables
    by a criterion independent of the test statistic, and then only
    tests variables which pass the filter, can provide higher power. We
    show that use of some filter/test statistics pairs presented in the
    literature may, however, lead to loss of type I error control. We
    describe other pairs which avoid this problem. In an application to
    microarray data, we found that gene-by-gene filtering by overall
    variance followed by a \textless jats:italic\textgreater
    t\textless/jats:italic\textgreater{} -test increased the number of
    discoveries by 50\%. We also show that this particular statistic
    pair induces a lower bound on fold-change among the set of
    discoveries. Independent filtering—using filter/test pairs that are
    independent under the null hypothesis but correlated under the
    alternative—is a general approach that can substantially increase
    the efficiency of experiments. \textless/jats:p\textgreater{}}
}
@article{doi:10.1186/s13059-014-0550-8,
  author = {Love, Michael I and Huber, Wolfgang and Anders, Simon},
  publisher = {Springer Science and Business Media LLC},
  title = {Moderated Estimation of Fold Change and Dispersion for
    {RNA-seq} Data with {DESeq2}},
  journal = {Genome Biology},
  volume = {15},
  number = {12},
  date = {2014-12-05},
  url = {https://doi.org/gd3zvn},
  doi = {10.1186/s13059-014-0550-8},
  note = {This CSL Item was generated by Manubot v0.6.1 from its
    persistent identifier (standard\_id). standard\_id:
    doi:10.1186/s13059-014-0550-8},
  langid = {en},
  abstract = {\textless jats:title\textgreater
    Abstract\textless/jats:title\textgreater{} \textless
    jats:p\textgreater{} In comparative high-throughput sequencing
    assays, a fundamental task is the analysis of count data, such as
    read counts per gene in RNA-seq, for evidence of systematic changes
    across experimental conditions. Small replicate numbers,
    discreteness, large dynamic range and the presence of outliers
    require a suitable statistical approach. We present \textless
    jats:italic\textgreater DESeq2\textless/jats:italic\textgreater{} ,
    a method for differential analysis of count data, using shrinkage
    estimation for dispersions and fold changes to improve stability and
    interpretability of estimates. This enables a more quantitative
    analysis focused on the strength rather than the mere presence of
    differential expression. The \textless jats:italic\textgreater
    DESeq2\textless/jats:italic\textgreater{} package is available at
    \textless jats:ext-link xmlns:xlink=“http://www.w3.org/1999/xlink”
    ext-link-type=“uri”
    xlink:href=“http://www.bioconductor.org/packages/release/bioc/html/DESeq2.html”\textgreater
    http://www.bioconductor.org/packages/release/bioc/html/DESeq2.html\textless/jats:ext-link\textgreater{}
    . \textless/jats:p\textgreater{}}
}
